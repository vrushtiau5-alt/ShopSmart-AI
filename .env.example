# Database Configuration (MySQL / Docker)
MYSQL_DATABASE=ai_shopping_assistant
MYSQL_USER=shopsmart
MYSQL_PASSWORD=change_me_password
MYSQL_ROOT_PASSWORD=change_me_root_password
DB_HOST=db
DB_PORT=3306
DB_USER=shopsmart
DB_PASSWORD=change_me_password
DB_NAME=ai_shopping_assistant

# Full Database Connection String (Used inside Docker Container)
DATABASE_URL=mysql+pymysql://shopsmart:change_me_password@db:3306/ai_shopping_assistant

# Flask Secret Key
SECRET_KEY=change_this_secret_key_in_production

# Application Environment
FLASK_ENV=production
DEBUG=False

# Admin Registration Authorization Code
ADMIN_INVITE_CODE=change_this_secure_code

# AI Service Configuration
AI_PROVIDER=gemini
AI_API_KEY=

# Mail Configuration
MAIL_SERVER=localhost
MAIL_PORT=25
MAIL_USE_TLS=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@shopsmart.ai

# Razorpay / Google Pay Payment Gateway Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
